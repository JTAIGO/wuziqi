.page {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background-color: #EDF2EC;
}

/* 竹林背景图：绝对定位铺满整个页面，置于内容之下 */
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

/* 内容区统一置于背景图之上 */
.scoreboard,
.menu-panel,
.board-area,
.toolbar,
.nav-bar {
  position: relative;
  z-index: 1;
}

/* 自定义导航栏：标题融入竹林背景，顶部留出状态栏安全区 */
/* 用 padding 撑高（而非 height），避免 box-sizing:border-box 下 padding 被压缩 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 16rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #2C3A33;
  line-height: 88rpx;
}

/* ---------------- 顶部对局信息 ---------------- */

.scoreboard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 2rpx solid rgba(70, 100, 80, 0.12);
}

.player {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: background-color 0.25s ease, border-color 0.25s ease;
}

.player.active {
  background: rgba(224, 163, 44, 0.14);
  border-color: rgba(180, 130, 30, 0.45);
}

.stone {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.stone-black {
  background: radial-gradient(circle at 32% 28%, #7C7C7C 0%, #2E2E2E 45%, #050505 100%);
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.5);
}

.stone-white {
  background: radial-gradient(circle at 32% 28%, #FFFFFF 0%, #F2F3F5 50%, #C6CAD2 100%);
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.35);
  border: 1rpx solid rgba(140, 145, 158, 0.4);
}

.player-meta {
  display: flex;
  flex-direction: column;
  margin-left: 14rpx;
}

.player-meta-right {
  align-items: flex-end;
  margin-left: 0;
  margin-right: 14rpx;
}

.player-name {
  font-size: 24rpx;
  line-height: 1.35;
  color: #3D4A43;
}

.player.active .player-name {
  color: #9A6B14;
}

.player-time {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  color: #2C3A33;
}

.center-info {
  display: flex;
  align-items: baseline;
  padding: 0 8rpx;
}

.move-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #2C3A33;
}

.move-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: #8A968F;
}

/* ---------------- 棋盘 ---------------- */

.board-area {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 0;
  margin: 32rpx 0;
}

.board-frame {
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(60, 90, 70, 0.22), 0 0 0 2rpx rgba(70, 100, 80, 0.14);
}

.board {
  display: block;
  width: 100%;
  height: 100%;
}

/* ---------------- 按钮 ---------------- */

.btn {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: opacity 0.2s ease;
}

.btn:active {
  opacity: 0.78;
}

.btn-ghost {
  color: #2E3B34;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(70, 100, 80, 0.2);
}

.btn-primary {
  color: #2A1F05;
  font-weight: 600;
  background: linear-gradient(135deg, #F6CE6A 0%, #E0A32C 100%);
  box-shadow: 0 8rpx 22rpx rgba(180, 130, 30, 0.28);
}

.btn.is-disabled {
  opacity: 0.45;
}

.toolbar {
  display: flex;
}

.toolbar .btn {
  flex: 1;
}

.toolbar .btn + .btn {
  margin-left: 16rpx;
}

.toolbar .btn-menu {
  flex: 0 0 120rpx;
}

/* ---------------- 禁手提示 ---------------- */

.forbid-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: rgba(220, 70, 70, 0.92);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  pointer-events: none;
  animation: hintPop 0.18s ease-out;
}

/* ---------------- AI 思考中提示 ---------------- */

.ai-hint {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(224, 163, 44, 0.16);
  border: 2rpx solid rgba(180, 130, 30, 0.4);
  color: #9A6B14;
  font-size: 24rpx;
  pointer-events: none;
}

/* ---------------- 开局设置弹窗 ---------------- */

.menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  background: rgba(24, 32, 27, 0.55);
}

.menu-dialog {
  width: 100%;
  display: flex;
  flex-direction: column;
  padding: 32rpx 32rpx 36rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(70, 100, 80, 0.14);
  box-shadow: 0 24rpx 60rpx rgba(30, 45, 36, 0.32);
}

.menu-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.menu-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #9A6B14;
}

.menu-x {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 40rpx;
  color: #6B7A72;
  background: rgba(70, 100, 80, 0.08);
}

.menu-group {
  margin-bottom: 22rpx;
}

.menu-group:last-of-type {
  margin-bottom: 0;
}

.menu-label {
  display: block;
  font-size: 24rpx;
  color: #6B7A72;
  margin-bottom: 12rpx;
}

.menu-options {
  display: flex;
}

.menu-opt {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 27rpx;
  color: #3A4A42;
  background: rgba(70, 100, 80, 0.07);
  border: 2rpx solid rgba(70, 100, 80, 0.12);
  transition: all 0.2s ease;
}

.menu-opt + .menu-opt {
  margin-left: 16rpx;
}

.menu-opt.on {
  color: #2A1F05;
  font-weight: 600;
  background: linear-gradient(135deg, #F6CE6A 0%, #E0A32C 100%);
  border-color: transparent;
}

/* ---------------- 动画 ---------------- */

@keyframes hintPop {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.8);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}
